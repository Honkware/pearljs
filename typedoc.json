{
  "$schema": "https://typedoc.org/schema.json",
  "name": "pearljs",
  "entryPoints": [
    "src/index.ts",
    "src/address.ts",
    "src/amount.ts",
    "src/backend.ts",
    "src/block.ts",
    "src/blockheader.ts",
    "src/builder.ts",
    "src/client.ts",
    "src/coinselect.ts",
    "src/consensus.ts",
    "src/crypto.ts",
    "src/discovery.ts",
    "src/errors.ts",
    "src/gcs.ts",
    "src/inspect.ts",
    "src/invoice.ts",
    "src/keys.ts",
    "src/message.ts",
    "src/mnemonic.ts",
    "src/multia.ts",
    "src/networks.ts",
    "src/payments.ts",
    "src/policy.ts",
    "src/rbf.ts",
    "src/rpc.ts",
    "src/script.ts",
    "src/scriptpath.ts",
    "src/scripttools.ts",
    "src/scripttree.ts",
    "src/sweep.ts",
    "src/transaction.ts",
    "src/wif.ts",
    "src/ws.ts",
    "src/xmss.ts",
    "src/xmss-file-store.ts"
  ],
  "tsconfig": "tsconfig.build.json",
  "out": "docs/api",
  "readme": "none",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "githubPages": false
}
