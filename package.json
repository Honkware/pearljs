  "files": [
    "dist",
    "docs/**/*.md",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "examples": "node scripts/run-examples.mjs",
    "demo": "npm run build && tsc -p tsconfig.examples.json && node dist-examples/examples/invoice-demo.js",
    "test": "vitest run",
    "test:live": "vitest run --config test/live/vitest.config.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "lint": "eslint src test examples scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:pack": "node scripts/verify-pack.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "docs": "typedoc",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run examples && npm run check:docs",
    "prepack": "npm run build"
  },
  "keywords": [
    "pearl",
    "taproot",
    "psbt",
    "p2mr",
    "xmss",
    "bip39",
    "bip32",
    "bip86"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Honkware/pearljs.git"
  },
  "homepage": "https://nacre.gitbook.io/pearljs",
  "bugs": {
    "url": "https://github.com/Honkware/pearljs/issues"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@scure/bip39": "1.6.0",
    "bech32": "2.0.0",
    "bip32": "5.0.1",
    "bitcoinjs-lib": "7.0.5",
    "tiny-secp256k1": "2.2.5"
  },
  "devDependencies": {
    "@types/node": "20.19.25",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "fake-indexeddb": "6.2.5",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "undici": "6.29.1",
    "vite": "7.3.8",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "4.1.12"
  },
  "sideEffects": false,
  "imports": {
    "#secp256k1": {
      "worker": "./dist/secp256k1-worker.js",
      "default": "tiny-secp256k1"
    }
  }
